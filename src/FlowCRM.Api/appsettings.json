{
  "ConnectionStrings": {
    "FlowCrm": "Server=localhost,1433;Database=FlowCRM;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True;Encrypt=True"
  },
  "DatabaseProvider": "SqlServer",
  "Jwt": {
